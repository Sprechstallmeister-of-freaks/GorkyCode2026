# Set these as environment variables; this file is only a reference.
ASSISTANT_TIMEZONE=Europe/Moscow
ASSISTANT_DB=assistant.db
ASSISTANT_IMPORT_SEED=1
ASSISTANT_SEED_CSV=data/events.csv

# Optional: without a key the app automatically uses the local rule dialogue.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=30
