# Copy to .env for local use. Real environment variables take precedence.
ASSISTANT_TIMEZONE=Europe/Moscow
ASSISTANT_DB=assistant.db
ASSISTANT_IMPORT_SEED=1
ASSISTANT_SEED_CSV=data/events.csv

# Logging
# Уровень логирования: DEBUG, INFO, WARNING, ERROR (по умолчанию INFO)
ASSISTANT_LOG_LEVEL=INFO
# Путь к файлу логов с ротацией (опционально, по умолчанию только stdout)
# ASSISTANT_LOG_FILE=logs/assistant.log

# Optional: without keys the app automatically uses the local rule dialogue.
# Single-key backward-compatible variant: DEEPSEEK_API_KEY=your_key
# Multiple keys for automatic quota failover, separated by commas:
DEEPSEEK_API_KEYS=key1,key2,key3
DEEPSEEK_BASE_URL=https://api.literouter.com/v1
DEEPSEEK_MODEL=deepseek-v4.1-flash-1017:free
DEEPSEEK_TIMEOUT_SECONDS=30
